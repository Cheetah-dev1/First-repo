# ============================================================
# SmartStack — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------------
# Anthropic API
# ------------------------------------------------------------------
# Your secret key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for classification and Q&A
# Default: claude-sonnet-4-20250514
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens in Claude's response
# Default: 1024
CLAUDE_MAX_TOKENS=1024

# Number of retry attempts for Claude API calls
# Default: 3
CLAUDE_RETRY_COUNT=3

# ------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------
# Filename of your OAuth 2.0 client secret JSON, placed inside
# the smartstack/credentials/ directory.
# Download from: Google Cloud Console → APIs & Services → Credentials
OAUTH_CLIENT_SECRET_FILE=client_secret.json

# ------------------------------------------------------------------
# Google Drive folder names
# Customise if you want different subfolder names in your Drive.
# ------------------------------------------------------------------
FOLDER_STUDY=Study
FOLDER_COLLEGE_ADMIN=College Admin
FOLDER_PERSONAL_FUN=Personal/Fun

# ------------------------------------------------------------------
# Google Sheets
# ------------------------------------------------------------------
# Name of the spreadsheet that SmartStack will create/use
SHEET_NAME=SmartStack Log

# ------------------------------------------------------------------
# PDF processing
# ------------------------------------------------------------------
# Maximum words extracted from each PDF before sending to Claude.
# Reduce if you hit token-limit errors; increase for more context.
MAX_WORDS=3000
