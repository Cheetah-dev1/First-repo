# ============================================================
# SmartStack — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------------
# Gemini API (free — get your key at https://aistudio.google.com/apikey)
# ------------------------------------------------------------------
GEMINI_API_KEY=

# Gemini model to use
# Default: gemini-2.0-flash (free tier)
GEMINI_MODEL=gemini-2.0-flash

# Maximum tokens in Gemini's response
MAX_TOKENS=1024

# Number of retry attempts for API calls
RETRY_COUNT=3

# ------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------
# Filename of your OAuth 2.0 client secret JSON, placed inside
# the smartstack/credentials/ directory.
OAUTH_CLIENT_SECRET_FILE=client_secret.json

# ------------------------------------------------------------------
# Google Drive folder names
# ------------------------------------------------------------------
FOLDER_STUDY=Study
FOLDER_COLLEGE_ADMIN=College Admin
FOLDER_PERSONAL_FUN=Personal/Fun

# ------------------------------------------------------------------
# Google Sheets
# ------------------------------------------------------------------
SHEET_NAME=SmartStack Log

# ------------------------------------------------------------------
# PDF processing
# ------------------------------------------------------------------
MAX_WORDS=3000
